  <!-- Apply a saved theme before first paint. With nothing saved, the system setting wins. -->
  <script>
    try {
      var saved = localStorage.getItem('hcs-theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    } catch (e) {}
